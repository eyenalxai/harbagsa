#version 460

#extension GL_EXT_ray_query : require

layout(local_size_x = 64) in;

#include "camera.glsl"
#include "probe.glsl"
#include "sky.glsl"

struct ObjectData {
    mat4 model;
    mat4 prev_model;
    vec4 color;
};

struct Light {
    vec4 position;
    vec4 color;
};

layout(set = 0, binding = 1) readonly buffer Objects {
    ObjectData objects[];
} scene;

layout(set = 0, binding = 2) uniform accelerationStructureEXT scene_tlas;

layout(set = 0, binding = 3) readonly buffer Lights {
    Light lights[];
} light_set;

layout(set = 0, binding = 9) readonly buffer ProbePositions {
    vec4 positions[];
} probe_positions;

layout(set = 0, binding = 10) writeonly buffer ProbeRays {
    vec4 rays[];
} probe_rays;

layout(push_constant) uniform ProbePush {
    uint first_probe;
    uint probe_count;
    uint reset;
    uint pad;
} push;

const vec3 SUN_COLOR = vec3(1.0, 0.98, 0.94);
const uint SUN_RAY_MASK = 0xFFu;
const uint POINT_RAY_MASK = 0x02u;
const float POINT_SHADOW_END_BIAS = 0.001;
const float PROBE_ORIGIN_BIAS = 0.001;

bool occluded(vec3 origin, vec3 direction, uint mask, float max_distance) {
    rayQueryEXT query;
    rayQueryInitializeEXT(
        query,
        scene_tlas,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
        mask,
        origin,
        PROBE_ORIGIN_BIAS,
        direction,
        max_distance
    );
    while (rayQueryProceedEXT(query)) {}
    return rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// The probe rays shade a real hit. The cube mesh is a unit cube, so the
// dominant local axis is the face normal even after an arbitrary instance
// rotation.
vec3 hit_normal(mat4 object_to_world, vec3 local_hit) {
    vec3 magnitude = abs(local_hit);
    vec3 local_normal;
    if (magnitude.x >= magnitude.y && magnitude.x >= magnitude.z) {
        local_normal = vec3(sign(local_hit.x), 0.0, 0.0);
    } else if (magnitude.y >= magnitude.z) {
        local_normal = vec3(0.0, sign(local_hit.y), 0.0);
    } else {
        local_normal = vec3(0.0, 0.0, sign(local_hit.z));
    }
    return normalize(transpose(inverse(mat3(object_to_world))) * local_normal);
}

vec3 hit_radiance(vec3 origin, vec3 direction, float distance, out float hit_distance) {
    rayQueryEXT query;
    rayQueryInitializeEXT(
        query,
        scene_tlas,
        gl_RayFlagsOpaqueEXT,
        0xFFu,
        origin,
        PROBE_ORIGIN_BIAS,
        direction,
        distance
    );
    while (rayQueryProceedEXT(query)) {}

    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        hit_distance = distance;
        return sky_color(direction, normalize(-camera.light_direction.xyz), camera.sun.x);
    }

    uint instance_index = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
    float t = rayQueryGetIntersectionTEXT(query, true);
    mat4x3 transform = rayQueryGetIntersectionObjectToWorldEXT(query, true);
    mat4 object_to_world = mat4(
        vec4(transform[0], 0.0),
        vec4(transform[1], 0.0),
        vec4(transform[2], 0.0),
        vec4(transform[3], 1.0)
    );
    mat4 world_to_object = inverse(object_to_world);
    vec3 local_origin = (world_to_object * vec4(origin, 1.0)).xyz;
    vec3 local_direction = (world_to_object * vec4(direction, 0.0)).xyz;
    vec3 local_hit = local_origin + local_direction * t;
    vec3 normal = hit_normal(object_to_world, local_hit);
    vec3 hit_position = origin + direction * t;
    bool backface = dot(normal, direction) > 0.0;

    ObjectData object = scene.objects[instance_index];
    vec3 albedo = object.color.rgb;
    vec3 radiance = albedo * object.color.a;

    vec3 to_light = normalize(-camera.light_direction.xyz);
    float diffuse = max(dot(normal, to_light), 0.0);
    if (diffuse > 0.0) {
        if (!occluded(hit_position + normal * 0.002, to_light, SUN_RAY_MASK, 1000.0)) {
            radiance += albedo * SUN_COLOR * diffuse;
        }
    }

    bool shadows = camera.sun.w > 0.5;
    int light_count = int(camera.sun.z);
    for (int index = 0; index < light_count; ++index) {
        Light light = light_set.lights[index];
        vec3 offset = light.position.xyz - hit_position;
        float light_distance = length(offset);
        if (light_distance <= 0.0 || light_distance >= light.color.w) {
            continue;
        }
        vec3 light_direction = offset / light_distance;
        float light_diffuse = max(dot(normal, light_direction), 0.0);
        if (light_diffuse <= 0.0) {
            continue;
        }
        float reach = light_distance / light.color.w;
        float falloff = 1.0 - reach * reach;
        falloff *= falloff;
        if (shadows) {
            float shadow_distance = max(light_distance - POINT_SHADOW_END_BIAS, 0.0);
            if (occluded(
                hit_position + normal * 0.002,
                light_direction,
                POINT_RAY_MASK,
                shadow_distance
            )) {
                continue;
            }
        }
        radiance += albedo * light.color.rgb * (light.position.w * light_diffuse * falloff);
    }

    hit_distance = backface ? -t : t;
    return radiance;
}

void main() {
    uint ray_index = gl_GlobalInvocationID.x;
    uint local_probe = ray_index / uint(PROBE_RAYS);
    if (local_probe >= push.probe_count) {
        return;
    }
    uint probe_index = push.first_probe + local_probe;
    uint probe_ray = ray_index % uint(PROBE_RAYS);
    if (probe_positions.positions[probe_index].w < 0.5) {
        return;
    }
    vec3 probe_position = probe_positions.positions[probe_index].xyz;

    float hit_distance;
    vec3 radiance = hit_radiance(
        probe_position,
        probe_ray_direction(probe_ray),
        camera.sun.y,
        hit_distance
    );
    probe_rays.rays[probe_index * uint(PROBE_RAYS) + probe_ray] = vec4(
        radiance,
        hit_distance
    );
}
