{
  "requires": {"renderer_debug": true},
  "size": "1280x720",
  "view": {"hud": false, "debug": false, "hint": false, "perf": false},
  "analysis": false,
  "commands": [
    {"cmd": "remove", "name": "initial-lamp"},
    {"cmd": "remove", "name": "initial-panel"},
    {"cmd": "remove", "name": "initial-beacon"},
    {"cmd": "place", "prefab": "Pillar", "position": [0.5, 1.5, -18], "body": "static", "name": "occluder"},
    {"cmd": "place", "prefab": "Lamp", "position": [-1, 0.25, -15], "body": "dynamic", "name": "shadow-lamp",
     "light": {"color": "warm", "intensity": 4.0, "range": 12}},
    {"cmd": "camera", "position": [5, 2, -13], "look_at": [0, 1.2, -19.9], "fov_deg": 70},
    {"cmd": "settle", "frames": 90},
    {"cmd": "capture", "name": "before", "format": "stats", "png": true},
    {"cmd": "debug_mode", "active": true},
    {"cmd": "editor", "select_object": "shadow-lamp", "move": [-3, 0.25, -16]},
    {"cmd": "check", "field": "objects.shadow-lamp.position.x", "op": "eq", "value": -3},
    {"cmd": "check", "field": "objects.shadow-lamp.position.z", "op": "eq", "value": -16},
    {"cmd": "debug_mode", "active": false},
    {"cmd": "settle", "frames": 45},
    {"cmd": "capture", "name": "after", "format": "stats", "png": true}
  ],
  "checks": [
    {"field": "capture.named.after.delta_mean", "op": "gt", "value": 0.1},
    {"field": "capture.named.after.render_digest", "op": "ne", "other": "capture.named.before.render_digest"}
  ]
}
