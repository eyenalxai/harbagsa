{
  "requires": {"renderer_debug": true},
  "size": "640x360",
  "view": {"hud": false, "debug": false, "hint": false, "perf": false},
  "commands": [
    {"cmd": "renderer_debug", "taa": false},
    {"cmd": "camera", "position": [0, 3.0, 10.0], "yaw_deg": 0, "pitch_deg": -18},
    {"cmd": "settle", "frames": 10},
    {"cmd": "capture", "name": "before", "format": "stats", "png": true},

    {"cmd": "debug_mode", "active": true},
    {"cmd": "place", "name": "moving-lamp", "prefab": "Lamp", "position": [0, 2, 8], "body": "dynamic", "light": {"kind": "dynamic", "color": "warm", "intensity": 4, "range": 10}},
    {"cmd": "camera", "position": [0, 3.0, 12.0], "yaw_deg": 0, "pitch_deg": -10},
    {"cmd": "settle", "frames": 10},
    {"cmd": "capture", "name": "lamp-center", "format": "stats", "png": true},
    {"cmd": "editor", "select_object": "moving-lamp", "move": [-5.0, 2.0, 8.0]},
    {"cmd": "settle", "frames": 10},
    {"cmd": "capture", "name": "lamp-left", "format": "stats", "png": true},
    {"cmd": "debug_mode", "active": false},
    {"cmd": "remove", "name": "moving-lamp"},

    {"cmd": "place", "name": "fixture", "prefab": "Lamp", "position": [0, 2, 8], "body": "static", "light": {"kind": "static", "color": "warm", "intensity": 3, "range": 12}},
    {"cmd": "settle", "frames": 10},
    {"cmd": "capture", "name": "fixture-stale", "format": "stats", "png": true},
    {"cmd": "bake", "action": "publish", "threads": 16},
    {"cmd": "settle", "frames": 10},
    {"cmd": "capture", "name": "fixture-current", "format": "stats", "png": true},

    {"cmd": "remove", "name": "fixture"},
    {"cmd": "settle", "frames": 10},
    {"cmd": "capture", "name": "fixture-removed-stale", "format": "stats", "png": true},
    {"cmd": "bake", "action": "publish", "threads": 16},
    {"cmd": "settle", "frames": 10},
    {"cmd": "capture", "name": "fixture-removed-current", "format": "stats", "png": true},

    {"cmd": "remove", "name": "initial-lamp"},
    {"cmd": "remove", "name": "initial-panel"},
    {"cmd": "remove", "name": "initial-beacon"},
    {"cmd": "bake", "action": "publish", "threads": 16},
    {"cmd": "camera", "position": [17.0, 3.0, 17.0], "yaw_deg": -135, "pitch_deg": 0},
    {"cmd": "settle", "frames": 10},
    {"cmd": "capture", "name": "empty", "format": "stats", "png": true}
  ]
}
