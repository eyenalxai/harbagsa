{
  "note": "The inspector opens from the Debug action, selects a crate, drags its yaw, sets the body from the rail, duplicates and deletes it, then selects a lamp and changes its kind, colour, intensity, and range. The Debug section drags the type weight and turns on the physics draw. Every rail action asserts the applied game state; the separate scroll scenario proves the wheel on a naturally overflowing rail.",
  "size": "1280x720",
  "view": {"hud": true, "debug": false, "hint": false},
  "commands": [
    {"cmd": "place", "prefab": "Crate", "position": [4, 1, 4], "name": "inspector-crate"},
    {"cmd": "place", "prefab": "Lamp", "position": [6, 2, 4], "name": "inspector-lamp"},
    {"cmd": "ui", "click": "action:2", "expect": {"kind": "Debug_Inspector"}, "expect_state": {"ui.surface": "inspector", "ui.inspector.open": true, "ui.pointer_free": true}},
    {"cmd": "settle", "frames": 1},
    {"cmd": "capture", "name": "inspector-open", "format": "png"},
    {"cmd": "editor", "select_object": "inspector-crate"},
    {"cmd": "settle", "frames": 1},
    {"cmd": "settle", "frames": 1},
    {"cmd": "capture", "name": "inspector-object", "format": "png"},
    {"cmd": "ui", "click": "inspector.body/segment0", "expect": {"kind": "Object_Set", "value": 0}, "expect_state": {"editor.selection.body": "static", "ui.inspector.section": "object"}},
    {"cmd": "ui", "drag": {"from": "inspector.yaw", "dx": 400, "dy": 0, "steps": 6}, "expect": {"kind": "Object_Set", "value": 1}, "expect_state": {"editor.selection.yaw_deg": 359}},
    {"cmd": "settle", "frames": 1},
    {"cmd": "capture", "name": "inspector-object-edited", "format": "png"},
    {"cmd": "ui", "click": "inspector.duplicate", "expect": {"kind": "Object_Duplicate"}, "expect_state": {"objects.count": 9, "editor.selection.present": true}},
    {"cmd": "settle", "frames": 10},
    {"cmd": "capture", "name": "inspector-duplicate", "format": "png", "note": "The duplicate is selected."},
    {"cmd": "ui", "click": "inspector.delete", "expect": {"kind": "Object_Delete"}, "expect_state": {"objects.count": 8, "editor.selection.present": false}},
    {"cmd": "settle", "frames": 60},
    {"cmd": "capture", "name": "inspector-delete", "format": "png", "note": "Delete cleared the selection."},
    {"cmd": "editor", "select_object": "inspector-lamp"},
    {"cmd": "settle", "frames": 1},
    {"cmd": "capture", "name": "inspector-lamp", "format": "png"},
    {"cmd": "settle", "frames": 2},
    {"cmd": "ui", "click": "inspector.kind/segment0", "expect": {"kind": "Lamp_Kind", "value": 1}, "expect_state": {"editor.selection.light.kind": "static"}},
    {"cmd": "ui", "click": "inspector.color:2", "expect": {"kind": "Lamp_Color", "value": 2}, "expect_state": {"editor.selection.light.color": "red"}},
    {"cmd": "ui", "drag": {"from": "inspector.intensity", "dx": -400, "dy": 0, "steps": 6}, "expect": {"kind": "Lamp_Set", "value": 0}, "expect_state": {"editor.selection.light.intensity": 0.2}},
    {"cmd": "ui", "drag": {"from": "inspector.range", "dx": -400, "dy": 0, "steps": 6}, "expect": {"kind": "Lamp_Set", "value": 1}, "expect_state": {"editor.selection.light.range": 2}},
    {"cmd": "settle", "frames": 1},
    {"cmd": "capture", "name": "inspector-lamp-edited", "format": "png"},
    {"cmd": "ui", "drag": {"from": "inspector.weight", "dx": -400, "dy": 0, "steps": 6}, "expect": {"kind": "Type_Weight_Set"}, "expect_state": {"settings.type_weight": 100}},
    {"cmd": "settle", "frames": 1},
    {"cmd": "capture", "name": "inspector-weight", "format": "png"},
    {"cmd": "ui", "click": "inspector.physics", "expect": {"kind": "Physics_Debug", "value": 1}, "expect_state": {"editor.physics_debug": true}},
    {"cmd": "settle", "frames": 1},
    {"cmd": "capture", "name": "inspector-physics", "format": "png"},
    {"cmd": "ui", "click": "inspector.close", "expect": {"kind": "Toggle_Inspector"}, "expect_state": {"ui.inspector.open": false, "ui.surface": "hud", "ui.pointer_free": false}},
    {"cmd": "settle", "frames": 1},
    {"cmd": "capture", "name": "inspector-closed", "format": "png"}
  ]
}