{
  "size": "1280x720",
  "view": {"hud": false, "debug": false, "hint": false, "perf": false},
  "analysis": false,
  "commands": [
    {"cmd": "remove", "name": "initial-lamp"},
    {"cmd": "remove", "name": "initial-panel"},
    {"cmd": "remove", "name": "initial-beacon"},
    {"cmd": "check", "field": "debug.lights.active", "op": "eq", "value": 0},
    {"cmd": "camera", "position": [-12, 1.7, 6], "look_at": [0, 1, 0], "fov_deg": 90},
    {"cmd": "settle", "frames": 60},
    {"cmd": "check", "field": "renderer.probe_count", "op": "eq", "value": 1200},
    {"cmd": "check", "field": "renderer.debug.gi", "op": "eq", "value": true},
    {"cmd": "capture", "name": "gi-dark", "format": "stats", "png": true}
  ],
  "checks": [
    {"field": "capture.named.gi-dark.stats.mean.y", "op": "lt", "value": 0.5},
    {"field": "capture.named.gi-dark.stats.coverage.zero_fraction", "op": "gt", "value": 0.8}
  ]
}
