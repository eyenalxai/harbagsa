{
  "note": "96 synthetic point lights at 1080p. One perf command brackets direct, lightmap, probe, and mixed with a direct window, three rounds, so a clock drift cannot masquerade as a term cost.",
  "size": "1920x1080",
  "requires": {"renderer_debug": true},
  "view": {"hud": false, "debug": false, "hint": false, "perf": false},
  "commands": [
    {"cmd": "bake"},
    {"cmd": "renderer_debug", "synthetic_lights": 96},
    {"cmd": "perf", "name": "mixed-lighting", "frames": 120, "warmup": 30,
     "prime": "once", "rounds": 3, "baseline": "direct",
     "variants": {
       "direct": {"lightmap": false, "probe": false},
       "lightmap": {"lightmap": true, "probe": false},
       "probe": {"lightmap": false, "probe": true},
       "mixed": {"lightmap": true, "probe": true}
     }},
    {"cmd": "renderer_debug", "lightmap": true, "probe": true},
    {"cmd": "capture", "name": "lights-96", "format": "stats", "png": true,
     "note": "The 96-light field with both indirect terms."}
  ]
}
