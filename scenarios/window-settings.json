{
  "commands": [
    {"cmd": "menu", "open": true, "item": "Window mode"},
    {"cmd": "menu", "item": "Display", "activate": true},
    {"cmd": "check", "field": "settings.resolution", "op": "eq", "value": "2560x1440"},
    {"cmd": "check", "field": "settings.window_resolution", "op": "eq", "value": "1280x720"},
    {"cmd": "menu", "item": "Resolution", "activate": true},
    {"cmd": "capture", "name": "window-settings"},
    {"cmd": "menu", "open": false},
    {"cmd": "state"}
  ],
  "checks": [
    {"field": "settings.window_mode", "op": "eq", "value": "Windowed"},
    {"field": "settings.display", "op": "eq", "value": "Display 2"},
    {"field": "settings.display_index", "op": "eq", "value": 1},
    {"field": "settings.resolution", "op": "eq", "value": "1920x1080"},
    {"field": "settings.window_resolution", "op": "eq", "value": "1920x1080"}
  ]
}
