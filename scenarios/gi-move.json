{
  "requires": {"renderer_debug": true},
  "size": "1280x720",
  "view": {"hud": false, "debug": false, "hint": false, "perf": false},
  "analysis": false,
  "commands": [
    {"cmd": "remove", "name": "initial-lamp"},
    {"cmd": "remove", "name": "initial-panel"},
    {"cmd": "remove", "name": "initial-beacon"},
    {"cmd": "place", "prefab": "Pillar", "position": [0.5, 1.5, -18], "body": "static", "name": "occluder"},
    {"cmd": "place", "prefab": "Lamp", "position": [-3, 0.25, -14], "body": "dynamic", "name": "moving-lamp",
     "light": {"color": "warm", "intensity": 4.0, "range": 12}},
    {"cmd": "camera", "position": [5, 2, -13], "look_at": [0, 1.2, -19.9], "fov_deg": 70},
    {"cmd": "settle", "frames": 90},
    {"cmd": "capture", "name": "left-gi", "format": "stats", "png": true},
    {"cmd": "renderer_debug", "gi": false},
    {"cmd": "settle", "frames": 40},
    {"cmd": "capture", "name": "left-direct", "format": "stats", "png": true},
    {"cmd": "renderer_debug", "gi": true},
    {"cmd": "remove", "name": "moving-lamp"},
    {"cmd": "place", "prefab": "Lamp", "position": [4, 0.25, -14], "body": "dynamic", "name": "moving-lamp",
     "light": {"color": "warm", "intensity": 4.0, "range": 12}},
    {"cmd": "settle", "frames": 90},
    {"cmd": "capture", "name": "right-gi", "format": "stats", "png": true},
    {"cmd": "renderer_debug", "gi": false},
    {"cmd": "settle", "frames": 40},
    {"cmd": "capture", "name": "right-direct", "format": "stats", "png": true}
  ],
  "checks": [
    {"field": "capture.named.left-gi.stats.mean.y", "op": "gt", "other": "capture.named.left-direct.stats.mean.y"},
    {"field": "capture.named.right-gi.stats.mean.y", "op": "gt", "other": "capture.named.right-direct.stats.mean.y"},
    {"field": "capture.named.left-gi.render_digest", "op": "ne", "other": "capture.named.right-gi.render_digest"}
  ]
}
