{
  "size": "1280x720",
  "view": {"hud": false, "debug": false, "hint": false, "perf": false},
  "analysis": false,
  "parameters": {
    "lamp_intensity": 2.5,
    "lamp_range": 10
  },
  "commands": [
    {"cmd": "remove", "name": "initial-lamp"},
    {"cmd": "remove", "name": "initial-panel"},
    {"cmd": "remove", "name": "initial-beacon"},
    {"cmd": "check", "field": "objects.count", "op": "eq", "value": 3},
    {"cmd": "check", "field": "debug.lights.active", "op": "eq", "value": 0},
    {"cmd": "camera", "position": [-12, 1.7, 6], "look_at": [0, 1, 0], "fov_deg": 90},
    {"cmd": "settle", "frames": 40},
    {"cmd": "capture", "name": "unlit", "format": "stats", "png": true},
    {"cmd": "place", "prefab": "Lamp", "position": [-12, 2.0, 2.0], "body": "static", "name": "scenario-lamp",
     "light": {"intensity": "${lamp_intensity}", "range": "${lamp_range}"}},
    {"cmd": "check", "field": "objects.count", "op": "eq", "value": 4},
    {"cmd": "check", "field": "objects.scenario-lamp.prefab", "op": "eq", "value": "Lamp"},
    {"cmd": "check", "field": "objects.scenario-lamp.light.color", "op": "eq", "value": "warm"},
    {"cmd": "check", "field": "objects.scenario-lamp.light.intensity", "op": "eq", "value": "${lamp_intensity}"},
    {"cmd": "check", "field": "objects.scenario-lamp.light.range", "op": "eq", "value": "${lamp_range}"},
    {"cmd": "check", "field": "debug.lights.active", "op": "eq", "value": 1},
    {"cmd": "settle", "frames": 60},
    {"cmd": "capture", "name": "lamp-on", "format": "stats", "png": true},
    {"cmd": "remove", "name": "scenario-lamp"},
    {"cmd": "check", "field": "objects.count", "op": "eq", "value": 3},
    {"cmd": "check", "field": "debug.lights.active", "op": "eq", "value": 0},
    {"cmd": "settle", "frames": 40},
    {"cmd": "capture", "name": "lamp-off", "format": "stats", "png": true}
  ],
  "checks": [
    {"field": "capture.named.unlit.stats.mean.y", "op": "lt", "value": 0.5},
    {"field": "capture.named.lamp-on.stats.mean.y", "op": "gt", "other": "capture.named.unlit.stats.mean.y"},
    {"field": "capture.named.lamp-off.stats.mean.y", "op": "lt", "value": 0.5},
    {"field": "capture.named.lamp-on.stats.mean.y", "op": "gt", "other": "capture.named.lamp-off.stats.mean.y"}
  ]
}
