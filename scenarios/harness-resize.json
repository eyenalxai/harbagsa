{
  "note": "A same-scale resize recreates the offscreen target at 1200x700 and 800x600. The HUD text region keeps its lit coverage at every extent, so the text atlas survives the reattach; the run fails if the region goes dark.",
  "size": "1280x720",
  "view": {"hud": true, "debug": false, "hint": false},
  "commands": [
    {"cmd": "settle", "frames": 30},
    {"cmd": "capture", "name": "text-1280", "format": "stats", "region": [20, 38, 350, 26],
     "coverage": {"lit": 160}, "require": {"lit_fraction_min": 0.02}},
    {"cmd": "capture", "name": "frame-1280", "format": "png"},
    {"cmd": "resize", "size": "1200x700",
     "expect_state": {"renderer.extent.width": 1200, "renderer.extent.height": 700,
                      "renderer.ui_scale": 1, "ui.scale": 1,
                      "ui.viewport.width": 1200, "ui.viewport.height": 700}},
    {"cmd": "settle", "frames": 2},
    {"cmd": "capture", "name": "text-1200", "format": "stats", "region": [20, 38, 350, 26],
     "coverage": {"lit": 160}, "require": {"lit_fraction_min": 0.02}},
    {"cmd": "capture", "name": "frame-1200", "format": "png"},
    {"cmd": "resize", "size": "800x600",
     "expect_state": {"renderer.extent.width": 800, "renderer.extent.height": 600,
                      "renderer.ui_scale": 1, "ui.scale": 1,
                      "ui.viewport.width": 800, "ui.viewport.height": 600}},
    {"cmd": "settle", "frames": 2},
    {"cmd": "capture", "name": "text-800", "format": "stats", "region": [20, 38, 350, 26],
     "coverage": {"lit": 160}, "require": {"lit_fraction_min": 0.02}},
    {"cmd": "capture", "name": "frame-800", "format": "png"},
    {"cmd": "resize", "size": "1280x720",
     "expect_state": {"renderer.extent.width": 1280, "renderer.extent.height": 720,
                      "renderer.ui_scale": 1, "ui.scale": 1,
                      "ui.viewport.width": 1280, "ui.viewport.height": 720}},
    {"cmd": "settle", "frames": 2},
    {"cmd": "capture", "name": "text-1280-back", "format": "stats",
     "region": [20, 38, 350, 26], "coverage": {"lit": 160},
     "require": {"lit_fraction_min": 0.02}},
    {"cmd": "capture", "name": "frame-1280-back", "format": "png"}
  ]
}
