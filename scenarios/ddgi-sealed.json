{
  "size": "640x360",
  "view": {"hud": false, "debug": false, "hint": false, "perf": false},
  "analysis": false,
  "note": "Sealed two-room pair at (-10, -8): a lamp in room A must not light room B; removing the door segment in the shared wall then admits light through the opening.",
  "commands": [
    {"cmd": "sun", "azimuth_deg": 270, "elevation_deg": -20, "diameter_deg": 0.53},

    {"cmd": "place", "prefab": "Wall", "position": [-10.0, 1.5, -9.75], "yaw_deg": 90, "body": "static"},
    {"cmd": "place", "prefab": "Wall", "position": [-10.0, 1.5, -6.25], "yaw_deg": 90, "body": "static"},
    {"cmd": "place", "prefab": "Wall", "position": [-14.0, 1.5, -8.0], "yaw_deg": 90, "body": "static"},
    {"cmd": "place", "prefab": "Wall", "position": [-6.0, 1.5, -8.0], "yaw_deg": 90, "body": "static"},
    {"cmd": "place", "prefab": "Wall", "position": [-12.0, 1.5, -6.0], "body": "static"},
    {"cmd": "place", "prefab": "Wall", "position": [-8.0, 1.5, -6.0], "body": "static"},
    {"cmd": "place", "prefab": "Wall", "position": [-12.0, 1.5, -10.0], "body": "static"},
    {"cmd": "place", "prefab": "Wall", "position": [-8.0, 1.5, -10.0], "body": "static"},
    {"cmd": "place", "prefab": "Platform", "position": [-12.0, 3.25, -8.0], "body": "static"},
    {"cmd": "place", "prefab": "Platform", "position": [-8.0, 3.25, -8.0], "body": "static"},

    {"cmd": "camera", "position": [-7.0, 1.7, -8.0], "look_at": [-10.0, 1.5, -8.0], "fov_deg": 90},
    {"cmd": "settle", "frames": 30},
    {"cmd": "capture", "name": "sealed-wall", "format": "stats", "png": true},
    {"cmd": "capture", "name": "sealed-depth", "target": "depth", "format": "stats"},

    {"cmd": "camera", "position": [-7.5, 1.7, -8.8], "look_at": [-6.25, 1.5, -8.8], "fov_deg": 90},
    {"cmd": "settle", "frames": 20},
    {"cmd": "capture", "name": "sealed-far", "format": "stats"},

    {"cmd": "place", "prefab": "Lamp", "position": [-12.5, 2.2, -8.0], "body": "static",
     "light": {"color": "warm", "intensity": 4, "range": 12}},
    {"cmd": "check", "field": "objects.count", "op": "eq", "value": 14},
    {"cmd": "check", "field": "objects.5.prefab", "op": "eq", "value": "Wall"},
    {"cmd": "check", "field": "objects.14.prefab", "op": "eq", "value": "Lamp"},
    {"cmd": "check", "field": "debug.lights.active", "op": "eq", "value": 1},
    {"cmd": "settle", "frames": 60},
    {"cmd": "camera", "position": [-7.0, 1.7, -8.0], "look_at": [-10.0, 1.5, -8.0], "fov_deg": 90},
    {"cmd": "settle", "frames": 20},
    {"cmd": "capture", "name": "sealed-lamp", "format": "stats", "png": true},

    {"cmd": "remove", "id": 5},
    {"cmd": "check", "field": "objects.count", "op": "eq", "value": 13},
    {"cmd": "settle", "frames": 120},

    {"cmd": "camera", "position": [-7.5, 1.7, -8.8], "look_at": [-6.25, 1.5, -8.8], "fov_deg": 90},
    {"cmd": "settle", "frames": 20},
    {"cmd": "capture", "name": "door-far", "format": "stats", "png": true},

    {"cmd": "camera", "position": [-7.0, 1.7, -7.0], "look_at": [-10.0, 1.5, -7.0], "fov_deg": 90},
    {"cmd": "settle", "frames": 20},
    {"cmd": "capture", "name": "door-near", "format": "stats", "png": true}
  ],
  "checks": [
    {"field": "renderer.probe_volume_count", "op": "eq", "value": 7},
    {"field": "renderer.probe_count", "op": "eq", "value": 633},
    {"field": "capture.named.sealed-wall.stats.mean.y", "op": "lt", "value": 0.5},
    {"field": "capture.named.sealed-wall.stats.mean.y", "op": "eq", "other": "capture.named.sealed-lamp.stats.mean.y", "tolerance": 0.05},
    {"field": "capture.named.sealed-lamp.stats.mean.y", "op": "lt", "value": 0.5},
    {"field": "capture.named.sealed-depth.stats.max.x", "op": "lt", "value": 0.999},
    {"field": "capture.named.sealed-depth.stats.max.x", "op": "gt", "value": 0.9},
    {"field": "capture.named.sealed-far.stats.mean.y", "op": "lt", "value": 0.5},
    {"field": "capture.named.door-far.stats.mean.y", "op": "gt", "value": 20},
    {"field": "capture.named.door-far.stats.mean.y", "op": "gt", "other": "capture.named.sealed-far.stats.mean.y"},
    {"field": "capture.named.door-far.stats.mean.y", "op": "lt", "other": "capture.named.door-near.stats.mean.y"},
    {"field": "capture.named.door-near.stats.mean.y", "op": "gt", "value": 100}
  ]
}
