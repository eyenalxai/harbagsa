{
  "requires": {"renderer_debug": true},
  "size": "800x600",
  "view": {"hud": false, "debug": false, "hint": false, "perf": false},
  "commands": [
    {"cmd": "sun", "azimuth_deg": 52.1, "elevation_deg": 25, "diameter_deg": 0.53},
    {"cmd": "camera", "position": [2.0, 1.7, -2.5], "yaw_deg": 31.5127, "pitch_deg": -25.7831},
    {"cmd": "settle", "frames": 120},
    {"cmd": "capture", "name": "sun-on", "format": "stats", "png": true, "region": {"x": 300, "y": 400, "w": 120, "h": 60}},
    {"cmd": "renderer_debug", "ao": false},
    {"cmd": "settle", "frames": 120},
    {"cmd": "capture", "name": "sun-off", "format": "stats", "png": true, "region": {"x": 300, "y": 400, "w": 120, "h": 60}},
    {"cmd": "renderer_debug", "ao": true},
    {"cmd": "settle", "frames": 120},
    {"cmd": "capture", "name": "shade-on", "format": "stats", "png": true, "region": {"x": 700, "y": 140, "w": 40, "h": 40}},
    {"cmd": "renderer_debug", "ao": false},
    {"cmd": "settle", "frames": 120},
    {"cmd": "capture", "name": "shade-off", "format": "stats", "png": true, "region": {"x": 700, "y": 140, "w": 40, "h": 40}}
  ],
  "checks": [
    {"field": "capture.count", "op": "eq", "value": 4},
    {"field": "capture.named.sun-on.stats.mean.y", "op": "lt", "other": "capture.named.sun-off.stats.mean.y"},
    {"field": "capture.named.shade-on.stats.mean.y", "op": "lt", "other": "capture.named.shade-off.stats.mean.y"},
    {"field": "capture.named.sun-on.stats.mean.y", "op": "gt", "value": 120},
    {"field": "capture.named.shade-on.stats.mean.y", "op": "gt", "value": 30},
    {"field": "capture.named.sun-on.png", "op": "eq", "value": true}
  ]
}
