{
  "requires": {"renderer_debug": true},
  "size": "1280x720",
  "view": {"hud": false, "debug": false, "hint": false, "perf": false},
  "analysis": false,
  "commands": [
    {"cmd": "remove", "name": "initial-lamp"},
    {"cmd": "remove", "name": "initial-panel"},
    {"cmd": "remove", "name": "initial-beacon"},
    {"cmd": "place", "prefab": "Pillar", "position": [0.5, 1.5, -18], "body": "static", "name": "occluder"},
    {"cmd": "place", "prefab": "Lamp", "position": [-1, 0.25, -15], "body": "dynamic", "name": "shadow-lamp",
     "light": {"color": "warm", "intensity": 4.0, "range": 12}},
    {"cmd": "camera", "position": [5, 2, -13], "look_at": [0, 1.2, -19.9], "fov_deg": 70},
    {"cmd": "settle", "frames": 90},
    {"cmd": "capture", "name": "shadows-on", "format": "stats", "png": true},
    {"cmd": "renderer_debug", "light_shadows": false},
    {"cmd": "settle", "frames": 40},
    {"cmd": "capture", "name": "shadows-off", "format": "stats", "png": true}
  ],
  "checks": [
    {"field": "objects.occluder.prefab", "op": "eq", "value": "Pillar"},
    {"field": "debug.lights.active", "op": "eq", "value": 1},
    {"field": "capture.named.shadows-on.stats.mean.y", "op": "lt", "other": "capture.named.shadows-off.stats.mean.y"},
    {"field": "capture.named.shadows-on.render_digest", "op": "ne", "other": "capture.named.shadows-off.render_digest"}
  ]
}
