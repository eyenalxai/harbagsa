{
  "requires": {"renderer_debug": true},
  "size": "1280x720",
  "parameters": {"lamp_x": 20.0},
  "view": {"hud": false, "debug": false, "hint": false},
  "commands": [
    {"cmd": "renderer_debug", "taa": false},
    {"cmd": "debug_mode", "active": true},
    {"cmd": "editor", "camera": {"position": [17.5, 1.7, -17.2], "yaw_deg": -47.3836, "pitch_deg": -14.8396}},
    {"cmd": "place", "prefab": "Lamp", "position": ["${lamp_x}", 2.0, -19.5],
     "name": "threshold-lamp",
     "light": {"kind": "static", "color": "warm", "intensity": 4.0, "range": 10}},
    {"cmd": "bake"},
    {"cmd": "settle", "frames": 20},
    {"cmd": "capture", "name": "wall", "format": "stats", "png": true, "region": {"x": 0, "y": 0, "w": 580, "h": 680}}
  ]
}
