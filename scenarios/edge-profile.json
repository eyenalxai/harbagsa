{
  "size": "640x360",
  "view": {"hud": false, "debug": false, "hint": false, "perf": false},
  "commands": [
    {"cmd": "camera", "position": [0, 20, 5], "yaw": 0, "pitch": -1.5},
    {"cmd": "settle", "frames": 8},
    {"cmd": "capture", "name": "edge-stats", "format": "stats", "region": {"x": 300, "y": 160, "w": 40, "h": 40}, "histogram": 8},
    {"cmd": "capture", "name": "edge-profile", "format": "profile", "profile": {"axis": "y", "at": 320, "from": 140, "to": 220}},
    {"cmd": "capture", "name": "edge-zoom", "crop": {"x": 300, "y": 160, "w": 40, "h": 20, "scale": 4}}
  ],
  "checks": [
    {"field": "capture.0.region.w", "op": "eq", "value": 40},
    {"field": "capture.0.stats.region.x", "op": "eq", "value": 300},
    {"field": "capture.0.histogram.bins", "op": "eq", "value": 8},
    {"field": "capture.1.profile.flat", "op": "eq", "value": false},
    {"field": "capture.1.profile.width", "op": "gt", "value": 0},
    {"field": "capture.2.crop.width", "op": "eq", "value": 160},
    {"field": "capture.2.crop.height", "op": "eq", "value": 80},
    {"field": "capture.2.written_width", "op": "eq", "value": 160}
  ]
}
