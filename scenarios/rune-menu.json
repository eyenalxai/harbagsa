{
  "note": "Settings is a Rune kit dialog. The HUD stays at 94%, then at 70% with tertiary text promoted to secondary. The dialog proves a track click, the shared settings step path, reduce motion, Resume, and the close control.",
  "size": "1280x720",
  "view": {"hud": true, "debug": false, "hint": false},
  "commands": [
    {"cmd": "settle", "frames": 1},
    {"cmd": "capture", "name": "hud-94", "format": "png"},
    {"cmd": "menu", "open": true},
    {"cmd": "settle", "frames": 30},
    {"cmd": "capture", "name": "settings", "format": "png"},
    {"cmd": "menu", "opacity": 70},
    {"cmd": "settle", "frames": 2},
    {"cmd": "capture", "name": "settings-70", "format": "png"},
    {"cmd": "menu", "open": false},
    {"cmd": "settle", "frames": 30},
    {"cmd": "capture", "name": "hud-70", "format": "png"},
    {"cmd": "menu", "open": true},
    {"cmd": "settle", "frames": 30},
    {"cmd": "ui", "click": "settings.opacity", "expect": {"kind": "Settings_Set", "id": 4, "scalar": 0.85}, "expect_state": {"settings.hud_opacity": 0.85, "ui.surface": "settings", "ui.menu.open": true, "ui.focus": "settings.opacity", "ui.actions.0.kind": "Settings_Set", "ui.actions.0.id": 4, "ui.actions.0.scalar": 0.85}},
    {"cmd": "settle", "frames": 2},
    {"cmd": "capture", "name": "settings-track-click", "format": "png"},
    {"cmd": "menu", "item": "HUD opacity", "activate": true, "direction": 1, "expect_state": {"settings.hud_opacity": 0.86}},
    {"cmd": "settle", "frames": 2},
    {"cmd": "capture", "name": "settings-key-step", "format": "png"},
    {"cmd": "menu", "reduce_motion": true, "expect_state": {"settings.reduce_motion": true}},
    {"cmd": "settle", "frames": 2},
    {"cmd": "capture", "name": "settings-reduce-motion", "format": "png"},
    {"cmd": "ui", "click": "settings.resume", "expect": {"kind": "Close_Menu"}, "expect_state": {"menu.open": false, "ui.surface": "hud", "ui.pointer_free": false}},
    {"cmd": "settle", "frames": 30},
    {"cmd": "capture", "name": "hud-resumed", "format": "png"},
    {"cmd": "menu", "open": true},
    {"cmd": "settle", "frames": 30},
    {"cmd": "ui", "click": "close", "expect": {"kind": "Close_Menu"}, "expect_state": {"menu.open": false, "ui.surface": "hud"}},
    {"cmd": "settle", "frames": 30},
    {"cmd": "capture", "name": "hud-closed", "format": "png"}
  ]
