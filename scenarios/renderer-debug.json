    {"cmd": "check", "field": "renderer.debug.ao_strength", "op": "eq", "value": 0.25},
    {"cmd": "check", "field": "renderer.debug.clip_height", "op": "eq", "value": 3},
    {"cmd": "renderer_debug", "ao_radius": null, "ao_strength": null, "clip_height": null},
