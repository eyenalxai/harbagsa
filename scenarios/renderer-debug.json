    {"cmd": "check", "field": "renderer.debug.light_shadows", "op": "eq", "value": false},
    {"cmd": "check", "field": "renderer.debug.synthetic_lights", "op": "eq", "value": 4},
    {"cmd": "check", "field": "renderer.debug.sky", "op": "eq", "value": false},
