{
  "requires": {"renderer_debug": true},
  "view": {"hud": false, "debug": false, "hint": false},
  "renderer_debug": {
    "jitter": false,
    "history_weight": 1.0,
    "clamp": false,
    "depth_trust": true,
    "synthetic_lights": 4
  },
  "commands": [
    {"cmd": "camera", "position": [-12, 1.7, 6.0], "yaw_deg": 0, "pitch_deg": -12.6051},
    {"cmd": "check", "field": "renderer.debug.active", "op": "eq", "value": true},
    {"cmd": "check", "field": "renderer.debug.jitter", "op": "eq", "value": false},
    {"cmd": "check", "field": "renderer.debug.history_weight", "op": "eq", "value": 1},
    {"cmd": "check", "field": "renderer.debug.clamp", "op": "eq", "value": false},
    {"cmd": "check", "field": "renderer.debug.depth_trust", "op": "eq", "value": true},
    {"cmd": "check", "field": "renderer.debug.synthetic_lights", "op": "eq", "value": 4},
    {"cmd": "settle", "frames": 8},
    {"cmd": "check", "field": "renderer.light_count", "op": "eq", "value": 4},
    {"cmd": "check", "field": "renderer.jitter_index", "op": "eq", "value": 0},
    {"cmd": "check", "field": "renderer.history_weight", "op": "eq", "value": 1},
    {"cmd": "check", "field": "renderer.taa_enabled", "op": "eq", "value": true},
    {"cmd": "capture", "name": "debug-frame"},
    {"cmd": "renderer_debug", "clip_height": 3.0},
    {"cmd": "check", "field": "renderer.debug.clip_height", "op": "eq", "value": 3},
    {"cmd": "renderer_debug", "clip_height": null},
    {"cmd": "check", "field": "renderer.debug.clip_height", "op": "eq", "value": 1000},
    {"cmd": "renderer_debug", "clear": true},
    {"cmd": "check", "field": "renderer.debug.active", "op": "eq", "value": false},
    {"cmd": "check", "field": "renderer.debug.jitter", "op": "eq", "value": true},
    {"cmd": "check", "field": "renderer.debug.synthetic_lights", "op": "eq", "value": 0},
    {"cmd": "check", "field": "renderer.last_reset", "op": "eq", "value": "debug_override"},
    {"cmd": "settle", "frames": 1},
    {"cmd": "check", "field": "renderer.light_count", "op": "eq", "value": 3},
    {"cmd": "check", "field": "renderer.convergence_frames", "op": "eq", "value": 1}
  ]
}
