{
  "requires": {"renderer_debug": true},
  "view": {"hud": false, "debug": false, "hint": false},
  "renderer_debug": {"jitter": false, "taa": false, "clip_height": 2.0},
  "commands": [
    {"cmd": "camera", "position": [0, 55, 20], "look_at": [0, 0, 0], "fov_deg": 70},
    {"cmd": "settle", "frames": 4},
    {"cmd": "check", "field": "static_boxes.count", "op": "eq", "value": 52},
    {"cmd": "check", "field": "static_boxes.0.half_extents.x", "op": "gt", "value": 0},
    {"cmd": "check", "field": "static_boxes.0.color.a", "op": "eq", "value": 1},
    {"cmd": "capture", "name": "plan", "format": "stats", "png": true}
  ]
}
