{
  "commands": [
    {"cmd": "displays", "set": [{"name": "Solo", "desktop": "1280x720", "modes": ["1280x720"]}]},
    {"cmd": "menu", "open": true, "item": "Display", "activate": true},
    {"cmd": "check", "field": "menu.status", "op": "eq", "value": "One display · nothing to change"},
    {"cmd": "check", "field": "menu.blocked", "op": "eq", "value": true},
    {"cmd": "rows"},
    {"cmd": "check", "field": "rows.menu.1.blocked", "op": "eq", "value": true},
    {"cmd": "check", "field": "rows.menu.3.kind", "op": "eq", "value": "slider"},
    {"cmd": "check", "field": "rows.menu.3.ticks", "op": "eq", "value": 9},
    {"cmd": "check", "field": "rows.hud.0.kind", "op": "eq", "value": "header"},
    {"cmd": "displays", "set": [{"name": "Solo"}]},
    {"cmd": "menu", "item": "Resolution", "activate": true},
    {"cmd": "check", "field": "menu.status", "op": "eq", "value": "No modes · nothing to change"},
    {"cmd": "check", "field": "menu.blocked", "op": "eq", "value": true},
    {"cmd": "check", "field": "settings.resolution", "op": "eq", "value": "0x0"},
    {"cmd": "displays", "clear": true},
    {"cmd": "check", "field": "settings.display_index", "op": "eq", "value": 0}
  ]
}
