{
  "note": "Thin-wall leak: a 0.5 m static wall between a bright static fixture and a dynamic crate on the far side. The thinnest wall tested is 0.5 m, the Wall prefab; 0.1-0.2 m remains untested. The side view picks the crate's probe term; the far view picks the wall's far-face lightmap term. The wall is then removed and the bake republished to measure the occlusion the probe field applies.",
  "size": "1280x720",
  "requires": {"renderer_debug": true},
  "view": {"hud": false, "debug": false, "hint": false, "perf": false},
  "commands": [
    {"cmd": "renderer_debug", "taa": false, "jitter": false},
    {"cmd": "place", "prefab": "Wall", "position": [-16.0, 1.5, -6.0], "name": "thin-wall"},
    {"cmd": "place", "prefab": "Lamp", "position": [-16.0, 1.2, -4.9], "name": "thin-wall-light", "light": {"kind": "static", "color": "warm", "intensity": 4.0, "range": 8}},
    {"cmd": "place", "prefab": "Crate", "position": [-16.0, 0.5, -7.5], "name": "thin-wall-crate"},
    {"cmd": "settle", "frames": 30},
    {"cmd": "bake"},
    {"cmd": "camera", "position": [-11.0, 1.7, -6.0], "look_at": [-16.0, 0.6, -7.2], "fov_deg": 55},
    {"cmd": "settle", "frames": 10},
    {"cmd": "capture", "name": "thin-wall", "views": ["beauty", "direct", "lightmap", "probe"], "format": "stats", "png": true, "note": "The crate on the far side; the wall blocks the fixture."},
    {"cmd": "pick", "at": [640, 360]},
    {"cmd": "pick", "at": [600, 380]},
    {"cmd": "pick", "at": [680, 380]},
    {"cmd": "camera", "position": [-16.0, 1.6, -10.5], "look_at": [-16.0, 1.3, -6.25], "fov_deg": 55},
    {"cmd": "settle", "frames": 4},
    {"cmd": "capture", "name": "thin-wall-far", "views": ["beauty", "lightmap"], "format": "stats", "png": true, "note": "The wall's far face, between the crate and the fixture."},
    {"cmd": "pick", "at": [640, 300]},
    {"cmd": "pick", "at": [500, 300]},
    {"cmd": "pick", "at": [780, 300]},
    {"cmd": "remove", "name": "thin-wall"},
    {"cmd": "bake"},
    {"cmd": "camera", "position": [-11.0, 1.7, -6.0], "look_at": [-16.0, 0.6, -7.2], "fov_deg": 55},
    {"cmd": "settle", "frames": 4},
    {"cmd": "capture", "name": "thin-wall-removed", "views": ["beauty", "direct", "lightmap", "probe"], "format": "stats", "png": true, "note": "The same view with the wall removed and the bake republished."},
    {"cmd": "pick", "at": [640, 360]},
    {"cmd": "pick", "at": [600, 380]},
    {"cmd": "pick", "at": [680, 380]}
  ]
}
