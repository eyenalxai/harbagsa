{
  "view": {"hud": false, "debug": false, "hint": false},
  "commands": [
    {"cmd": "camera", "position": [-12, 1.7, 6.0], "yaw": 0, "pitch": -0.22},
    {"cmd": "settle", "frames": 8},

    {"cmd": "capture", "name": "velocity-static", "target": "velocity", "format": "stats"},
    {"cmd": "check", "field": "capture.target", "op": "eq", "value": "velocity"},
    {"cmd": "check", "field": "capture.format", "op": "eq", "value": "stats"},
    {"cmd": "check", "field": "capture.stats.velocity_median_texels", "op": "le", "value": 0.01},
    {"cmd": "check", "field": "capture.stats.mean.z", "op": "gt", "value": 0},

    {"cmd": "capture", "name": "scene-color", "target": "scene_color", "format": "float"},
    {"cmd": "check", "field": "capture.target", "op": "eq", "value": "scene_color"},
    {"cmd": "check", "field": "capture.format", "op": "eq", "value": "float"},

    {"cmd": "capture", "name": "history", "target": "history", "format": "raw"},
    {"cmd": "check", "field": "capture.target", "op": "eq", "value": "history"},
    {"cmd": "check", "field": "capture.format", "op": "eq", "value": "raw"},

    {"cmd": "capture", "name": "depth", "target": "depth", "format": "stats"},
    {"cmd": "check", "field": "capture.target", "op": "eq", "value": "depth"},
    {"cmd": "check", "field": "capture.stats.mean.x", "op": "gt", "value": 0},
    {"cmd": "check", "field": "capture.stats.mean.x", "op": "lt", "value": 200},

    {"cmd": "camera", "position": [-12, 1.7, 5.5], "yaw": 0, "pitch": -0.22},
    {"cmd": "capture", "name": "velocity-moving", "target": "velocity", "format": "stats"},
    {"cmd": "check", "field": "capture.stats.velocity_median_texels", "op": "gt", "value": 1}
  ],
  "checks": [
    {"field": "capture.count", "op": "eq", "value": 5}
  ]
}
