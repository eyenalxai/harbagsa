{
  "note": "The shot shorthand expands to camera, settle, and capture.",
  "view": {"hud": false, "debug": false, "hint": false},
  "commands": [
    {
      "cmd": "shot",
      "name": "spawn",
      "note": "one frame after a two-frame settle",
      "camera": {"position": [0, 1.7, 6], "yaw_deg": 0, "pitch_deg": 0},
      "settle": 2,
      "format": "stats",
      "png": true,
      "region": {"x": 0, "y": 0, "w": 320, "h": 180}
    },
    {"cmd": "check", "field": "capture.count", "op": "eq", "value": 1},
    {"cmd": "check", "field": "capture.named.spawn.frame", "op": "eq", "value": 2},
    {"cmd": "check", "field": "capture.named.spawn.stats.region.w", "op": "eq", "value": 320}
  ]
}
