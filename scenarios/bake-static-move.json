{
  "note": "Author a static crate at a new position after a bake. The stale artifact does not carry the new box's chart; a republish gives it a tile.",
  "size": "1280x720",
  "requires": {"renderer_debug": true},
  "view": {"hud": false, "debug": false, "hint": false},
  "commands": [
    {"cmd": "renderer_debug", "taa": false, "jitter": false},
    {"cmd": "place", "prefab": "Crate", "position": [0, 0.5, 9.5], "body": "static", "name": "moved-static"},
    {"cmd": "bake"},
    {"cmd": "camera", "position": [2, 3, 11], "look_at": [0, 0.5, 9.5]},
    {"cmd": "settle", "frames": 30},
    {"cmd": "pick", "at": [640, 360]},
    {"cmd": "capture", "name": "baked", "views": ["beauty", "lightmap"], "format": "stats", "png": true},
    {"cmd": "remove", "name": "moved-static"},
    {"cmd": "place", "prefab": "Crate", "position": [2.0, 0.5, 9.5], "body": "static", "name": "moved-static"},
    {"cmd": "camera", "position": [4, 3, 11], "look_at": [2, 0.5, 9.5]},
    {"cmd": "settle", "frames": 30},
    {"cmd": "pick", "at": [640, 360]},
    {"cmd": "capture", "name": "stale", "views": ["beauty", "lightmap"], "format": "stats", "png": true},
    {"cmd": "bake"},
    {"cmd": "settle", "frames": 30},
    {"cmd": "pick", "at": [640, 360]},
    {"cmd": "capture", "name": "republished", "views": ["beauty", "lightmap"], "format": "stats", "png": true}
  ]
}
