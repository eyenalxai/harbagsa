{
  "note": "The inspector sliders follow multi-frame pointer drags: yaw commits at the 359-degree cap and again at 180, a held drag from 180 loses the pointer to focus loss and restores, and the lamp intensity, range, and type weight drag to their floors. Every drag asserts the applied game state; the separate scroll scenario proves the wheel on a naturally overflowing rail.",
  "size": "1280x720",
  "view": {"hud": true, "debug": false, "hint": false},
  "commands": [
    {"cmd": "place", "prefab": "Crate", "position": [4, 1, 4], "name": "inspector-crate"},
    {"cmd": "place", "prefab": "Lamp", "position": [6, 2, 4], "name": "inspector-lamp"},
    {"cmd": "ui", "click": "action:2", "expect": {"kind": "Debug_Inspector"}, "expect_state": {"ui.surface": "inspector", "ui.inspector.open": true}},
    {"cmd": "editor", "select_object": "inspector-crate"},
    {"cmd": "settle", "frames": 30},
    {"cmd": "ui", "drag": {"from": "inspector.yaw", "dx": 400, "dy": 0, "steps": 6}, "expect": {"kind": "Object_Set", "value": 1}, "expect_state": {"editor.selection.yaw_deg": 359, "editor.history.depth": 1}},
    {"cmd": "settle", "frames": 2},
    {"cmd": "capture", "name": "yaw-dragged", "format": "png"},
    {"cmd": "ui", "drag": {"from": "inspector.yaw", "dx": 0, "dy": 0, "steps": 1}, "expect": {"kind": "Object_Set", "value": 1}, "expect_state": {"editor.selection.yaw_deg": 180, "editor.history.depth": 2}},
    {"cmd": "settle", "frames": 2},
    {"cmd": "capture", "name": "yaw-reset", "format": "png"},
    {"cmd": "ui", "drag": {"from": "inspector.yaw", "dx": 40, "dy": 0, "steps": 4, "hold": true}, "expect_state": {"ui.pressed": "inspector.yaw", "ui.hover": "inspector.yaw", "editor.selection.yaw_deg": 180, "editor.history.depth": 2}},
    {"cmd": "capture", "name": "yaw-held", "format": "png"},
    {"cmd": "ui", "focus": false, "expect_state": {"ui.pressed": "", "ui.hover": "", "editor.selection.yaw_deg": 180, "editor.history.depth": 2}},
    {"cmd": "settle", "frames": 2},
    {"cmd": "capture", "name": "yaw-cancelled", "format": "png"},
    {"cmd": "ui", "focus": true, "expect_state": {"ui.surface": "inspector", "ui.pointer_free": true}},
    {"cmd": "editor", "select_object": "inspector-lamp"},
    {"cmd": "settle", "frames": 30},
    {"cmd": "settle", "frames": 2},
    {"cmd": "ui", "drag": {"from": "inspector.intensity", "dx": -400, "dy": 0, "steps": 6}, "expect": {"kind": "Lamp_Set", "value": 0}, "expect_state": {"editor.selection.light.intensity": 0.2}},
    {"cmd": "settle", "frames": 2},
    {"cmd": "capture", "name": "lamp-intensity-dragged", "format": "png"},
    {"cmd": "ui", "drag": {"from": "inspector.range", "dx": -400, "dy": 0, "steps": 6}, "expect": {"kind": "Lamp_Set", "value": 1}, "expect_state": {"editor.selection.light.range": 2}},
    {"cmd": "settle", "frames": 2},
    {"cmd": "capture", "name": "lamp-range-dragged", "format": "png"},
    {"cmd": "ui", "drag": {"from": "inspector.weight", "dx": -400, "dy": 0, "steps": 6}, "expect": {"kind": "Type_Weight_Set"}, "expect_state": {"settings.type_weight": 100}},
    {"cmd": "settle", "frames": 2},
    {"cmd": "capture", "name": "weight-dragged", "format": "png"}
  ]
}