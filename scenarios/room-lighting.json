{
  "size": "1280x720",
  "view": {"hud": false, "debug": false, "hint": false, "perf": false},
  "analysis": false,
  "parameters": {
    "sun_elevation_deg": 12,
    "lamp_intensity": 1.5,
    "lamp_range": 8,
    "patch_x": 400,
    "patch_y": 460,
    "patch_w": 500,
    "patch_h": 240
  },
  "commands": [
    {"cmd": "camera", "position": [5.5, 4.5, 10.5], "look_at": [13.5, 1.5, 10.5], "fov_deg": 90},
    {"cmd": "settle", "frames": 40},
    {"cmd": "capture", "name": "outside"},
    {"cmd": "camera", "position": [13.5, 1.7, 10.5], "yaw_deg": 90, "pitch_deg": -8.5944},
    {"cmd": "settle", "frames": 40},
    {"cmd": "capture", "name": "inside-door"},
    {"cmd": "camera", "position": [13.5, 1.7, 10.5], "look_at": [16.5, 1.4, 7.5], "fov_deg": 90},
    {"cmd": "settle", "frames": 40},
    {"cmd": "capture", "name": "sealed-corner"},
    {"cmd": "capture", "name": "sealed-depth", "target": "depth", "format": "stats"},
    {"cmd": "camera", "position": [13.5, 1.7, 10.5], "yaw_deg": 0, "pitch_deg": 68.7549},
    {"cmd": "settle", "frames": 40},
    {"cmd": "capture", "name": "ceiling"},
    {"cmd": "capture", "name": "ceiling-depth", "target": "depth", "format": "stats"},
    {"cmd": "sun", "azimuth_deg": 270, "elevation_deg": "${sun_elevation_deg}", "diameter_deg": 0.53},
    {"cmd": "camera", "position": [13.5, 1.7, 10.5], "yaw_deg": 90, "pitch_deg": -20.0535},
    {"cmd": "settle", "frames": 60},
    {"cmd": "capture", "name": "door-sun"},
    {"cmd": "capture", "name": "door-sun-patch", "format": "stats", "region": {"x": "${patch_x}", "y": "${patch_y}", "w": "${patch_w}", "h": "${patch_h}"}},
    {"cmd": "sun", "azimuth_deg": 90, "elevation_deg": "${sun_elevation_deg}", "diameter_deg": 0.53},
    {"cmd": "settle", "frames": 60},
    {"cmd": "capture", "name": "door-shade"},
    {"cmd": "capture", "name": "door-shade-patch", "format": "stats", "region": {"x": "${patch_x}", "y": "${patch_y}", "w": "${patch_w}", "h": "${patch_h}"}},
    {"cmd": "camera", "position": [16.0, 1.7, 13.0], "look_at": [11.5, 2.2, 9.5], "fov_deg": 90},
    {"cmd": "settle", "frames": 40},
    {"cmd": "capture", "name": "room-corner"},
    {"cmd": "place", "prefab": "Lamp", "position": [13.5, 2.75, 10.5], "body": "static", "light": {"intensity": "${lamp_intensity}", "range": "${lamp_range}"}},
    {"cmd": "check", "field": "objects.count", "op": "eq", "value": 4},
    {"cmd": "check", "field": "objects.4.prefab", "op": "eq", "value": "Lamp"},
    {"cmd": "check", "field": "objects.4.light.color", "op": "eq", "value": "warm"},
    {"cmd": "check", "field": "objects.4.light.intensity", "op": "eq", "value": "${lamp_intensity}"},
    {"cmd": "check", "field": "objects.4.light.range", "op": "eq", "value": "${lamp_range}"},
    {"cmd": "check", "field": "debug.lights.active", "op": "eq", "value": 1},
    {"cmd": "camera", "position": [16.0, 1.7, 13.0], "look_at": [11.5, 2.2, 9.5], "fov_deg": 90},
    {"cmd": "settle", "frames": 40},
    {"cmd": "capture", "name": "lamp-on"},
    {"cmd": "capture", "name": "lamp-on-stats", "format": "stats"},
    {"cmd": "remove", "id": 4},
    {"cmd": "check", "field": "objects.count", "op": "eq", "value": 3},
    {"cmd": "check", "field": "debug.lights.active", "op": "eq", "value": 0},
    {"cmd": "camera", "position": [16.0, 1.7, 13.0], "look_at": [11.5, 2.2, 9.5], "fov_deg": 90},
    {"cmd": "settle", "frames": 40},
    {"cmd": "capture", "name": "lamp-off"},
    {"cmd": "capture", "name": "lamp-off-stats", "format": "stats"}
  ],
  "checks": [
    {"field": "capture.named.sealed-depth.stats.max.x", "op": "lt", "value": 0.999},
    {"field": "capture.named.ceiling-depth.stats.max.x", "op": "lt", "value": 0.999},
    {"field": "capture.named.door-sun-patch.stats.mean.y", "op": "gt", "other": "capture.named.door-shade-patch.stats.mean.y"},
    {"field": "capture.named.door-sun-patch.stats.mean.y", "op": "gt", "value": 100},
    {"field": "capture.named.door-shade-patch.stats.mean.y", "op": "lt", "value": 95},
    {"field": "capture.named.lamp-on-stats.stats.mean.y", "op": "gt", "other": "capture.named.lamp-off-stats.stats.mean.y"},
    {"field": "capture.named.lamp-on-stats.stats.mean.y", "op": "gt", "value": 120},
    {"field": "capture.named.lamp-off-stats.stats.mean.y", "op": "lt", "value": 90}
  ]
}
