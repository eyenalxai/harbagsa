{
  "note": "A sealed four-wall cell with a static fixture inside, then the same fixture moved out of range. The cell geometry and chart sizes do not change, so the outer face must not change.",
  "size": "1280x720",
  "requires": {"renderer_debug": true},
  "view": {"hud": false, "debug": false, "hint": false, "perf": false},
  "commands": [
    {"cmd": "renderer_debug", "taa": false, "jitter": false},
    {"cmd": "place", "prefab": "Wall", "position": [8.0, 1.5, 0.0], "yaw_deg": 90, "name": "cell-west-low"},
    {"cmd": "place", "prefab": "Wall", "position": [12.0, 1.5, 0.0], "yaw_deg": 90, "name": "cell-east-low"},
    {"cmd": "place", "prefab": "Wall", "position": [10.0, 1.5, -2.0], "name": "cell-north-low"},
    {"cmd": "place", "prefab": "Wall", "position": [10.0, 1.5, 2.0], "name": "cell-south-low"},
    {"cmd": "place", "prefab": "Wall", "position": [8.0, 4.5, 0.0], "yaw_deg": 90, "name": "cell-west-high"},
    {"cmd": "place", "prefab": "Wall", "position": [12.0, 4.5, 0.0], "yaw_deg": 90, "name": "cell-east-high"},
    {"cmd": "place", "prefab": "Wall", "position": [10.0, 4.5, -2.0], "name": "cell-north-high"},
    {"cmd": "place", "prefab": "Wall", "position": [10.0, 4.5, 2.0], "name": "cell-south-high"},
    {"cmd": "place", "prefab": "Crate", "position": [11.0, 0.5, -2.85], "name": "cell-crate"},
    {"cmd": "place", "prefab": "Lamp", "position": [7.6, 2.0, -5.0], "name": "cell-fill",
     "light": {"kind": "static", "color": "cool", "intensity": 1.2, "range": 5}},
    {"cmd": "place", "prefab": "Lamp", "position": [10.0, 1.2, 0.0], "name": "cell-lamp",
     "light": {"kind": "static", "color": "warm", "intensity": 4.0, "range": 5}},
    {"cmd": "bake"},
    {"cmd": "camera", "position": [6.8, 2.4, -7.2], "look_at": [10.2, 1.3, -1.8], "fov_deg": 60},
    {"cmd": "settle", "frames": 10},
    {"cmd": "capture", "name": "wall-inside", "format": "stats", "png": true,
     "note": "Bright fixture sealed inside the cell; the outer face is lit from outside only."},
    {"cmd": "capture", "name": "wall-inside-crate", "format": "stats",
     "region": {"x": 760, "y": 300, "w": 200, "h": 160},
     "note": "Dynamic crate face outside the cell."},
    {"cmd": "capture", "name": "wall-inside-face", "format": "stats",
     "region": {"x": 200, "y": 200, "w": 400, "h": 250},
     "note": "Outer wall face of the cell."},
    {"cmd": "debug_mode", "active": true},
    {"cmd": "editor", "select_object": "cell-lamp"},
    {"cmd": "editor", "move": [19.0, 1.2, 18.0]},
    {"cmd": "debug_mode", "active": false},
    {"cmd": "bake"},
    {"cmd": "settle", "frames": 10},
    {"cmd": "capture", "name": "wall-away", "format": "stats", "png": true,
     "note": "Same view with the fixture moved out of range and the bake republished."},
    {"cmd": "capture", "name": "wall-away-crate", "format": "stats",
     "region": {"x": 760, "y": 300, "w": 200, "h": 160},
     "note": "Same crate region; compares with wall-inside-crate."},
    {"cmd": "capture", "name": "wall-away-face", "format": "stats",
     "region": {"x": 200, "y": 200, "w": 400, "h": 250},
     "note": "Same wall region; compares with wall-inside-face."}
  ]
}
